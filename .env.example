# Optional Angular workspace for local integration tests.
# Copy this file to .env; .env is ignored by git. Relative paths use this repo as the base.
NGWI_TEST_PROJECT_PATH=/absolute/path/to/angular-workspace
NGWI_TEST_PROJECT=app
NGWI_TEST_TARGET='data-id="targetInput"'
# Optional: select a candidate ID to generate and check a full report.
# NGWI_TEST_CANDIDATE=cand:...
